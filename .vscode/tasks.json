{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: deploy no celular",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/godot/deploy_celular.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Android: gerar APK",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/godot/build_android.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Android: abrir APK no emulador",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/godot/launch_android.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
