config_version=5

[application]
config/name="Alfabeto 3D — Jardim das Letras"
config/version="0.2.1"
run/main_scene="res://scenes/World.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[autoload]
EventBus="*res://scripts/event_bus.gd"
CatalogService="*res://scripts/catalog_service.gd"
ProgressService="*res://scripts/progress_service.gd"
AudioService="*res://scripts/audio_service.gd"
SceneRouter="*res://scripts/scene_router.gd"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[input_devices]
pointing/emulate_mouse_from_touch=true
